{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized system administrator entry keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user role and profile link record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "faculty", "student"] },
        "linkedProfileId": { "type": "string", "maxLength": 128 },
        "assignedClassIds": { "type": "array" },
        "assignedSubjectIds": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Configurable institutional branding and academic portal parameters.",
      "type": "object",
      "properties": {
        "collegeName": { "type": "string", "maxLength": 200 },
        "shortName": { "type": "string", "maxLength": 40 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "semester": { "type": "string", "maxLength": 32 },
        "effectiveFrom": { "type": "string", "maxLength": 32 },
        "defaultClassroom": { "type": "string", "maxLength": 64 },
        "timezone": { "type": "string", "maxLength": 64 },
        "lowAttendanceThreshold": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["collegeName", "shortName", "academicYear", "semester", "timezone", "lowAttendanceThreshold", "updatedAt"]
    },
    "Department": {
      "title": "Department",
      "description": "Academic department record.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "status", "createdAt", "updatedAt"]
    },
    "AcademicClass": {
      "title": "AcademicClass",
      "description": "Class, semester, section, and batch configuration.",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "departmentName": { "type": "string", "maxLength": 160 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "semester": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 160 },
        "section": { "type": "string", "maxLength": 32 },
        "classroom": { "type": "string", "maxLength": 64 },
        "batches": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["departmentId", "departmentName", "academicYear", "semester", "name", "section", "classroom", "batches", "status", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Theory, lab, or academic activity subject record.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "shortName": { "type": "string", "maxLength": 40 },
        "name": { "type": "string", "maxLength": 180 },
        "type": { "type": "string", "enum": ["theory", "lab", "activity"] },
        "departmentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "facultyIds": { "type": "array" },
        "facultyNames": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shortName", "name", "type", "departmentId", "classId", "facultyIds", "facultyNames", "status", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student master profile with RFID card UID and Google email link.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 64 },
        "rollNumber": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 32 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "departmentName": { "type": "string", "maxLength": 160 },
        "semester": { "type": "string", "maxLength": 32 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 160 },
        "section": { "type": "string", "maxLength": 32 },
        "batch": { "type": "string", "enum": ["B-I", "B-II", "ALL"] },
        "academicYear": { "type": "string", "maxLength": 32 },
        "rfidUid": { "type": "string", "maxLength": 64 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "rollNumber", "name", "email", "departmentId", "semester", "classId", "className", "section", "batch", "academicYear", "rfidUid", "status", "createdAt", "updatedAt"]
    },
    "Faculty": {
      "title": "Faculty",
      "description": "Faculty profile with assigned classes, subjects, and permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "facultyCode": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "departmentName": { "type": "string", "maxLength": 160 },
        "designation": { "type": "string", "maxLength": 120 },
        "assignedClassIds": { "type": "array" },
        "assignedSubjectIds": { "type": "array" },
        "canSubstitute": { "type": "boolean" },
        "canCorrectAttendance": { "type": "boolean" },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["facultyCode", "name", "email", "departmentId", "designation", "assignedClassIds", "assignedSubjectIds", "canSubstitute", "canCorrectAttendance", "status", "createdAt", "updatedAt"]
    },
    "TimetableEntry": {
      "title": "TimetableEntry",
      "description": "Master timetable period block (supports single or merged periods and batch splits).",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dayOfWeek": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] },
        "periodNumber": { "type": "number" },
        "endPeriodNumber": { "type": "number" },
        "startTime": { "type": "string", "maxLength": 16 },
        "endTime": { "type": "string", "maxLength": 16 },
        "isMerged": { "type": "boolean" },
        "isBatchSplit": { "type": "boolean" },
        "slots": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "dayOfWeek", "periodNumber", "endPeriodNumber", "startTime", "endTime", "isMerged", "isBatchSplit", "slots", "status", "createdAt", "updatedAt"]
    },
    "Substitution": {
      "title": "Substitution",
      "description": "Temporary date- and period-specific subject and faculty substitution.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 16, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "periodNumber": { "type": "number" },
        "endPeriodNumber": { "type": "number" },
        "batch": { "type": "string", "enum": ["ALL", "B-I", "B-II"] },
        "originalSubjectId": { "type": "string", "maxLength": 128 },
        "originalSubjectName": { "type": "string", "maxLength": 180 },
        "originalFacultyId": { "type": "string", "maxLength": 128 },
        "originalFacultyName": { "type": "string", "maxLength": 120 },
        "actualSubjectId": { "type": "string", "maxLength": 128 },
        "actualSubjectName": { "type": "string", "maxLength": 180 },
        "actualFacultyId": { "type": "string", "maxLength": 128 },
        "actualFacultyName": { "type": "string", "maxLength": 120 },
        "classroom": { "type": "string", "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 300 },
        "changedByUid": { "type": "string", "maxLength": 128 },
        "changedByName": { "type": "string", "maxLength": 120 },
        "changedByRole": { "type": "string", "enum": ["admin", "faculty"] },
        "status": { "type": "string", "enum": ["active", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "classId", "periodNumber", "endPeriodNumber", "batch", "originalSubjectId", "originalSubjectName", "actualSubjectId", "actualSubjectName", "actualFacultyId", "actualFacultyName", "classroom", "changedByUid", "changedByName", "changedByRole", "status", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Deterministic student/period/subject attendance record from RFID or manual entry.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentDocId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 120 },
        "studentEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "rollNumber": { "type": "string", "maxLength": 32 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 160 },
        "section": { "type": "string", "maxLength": 32 },
        "batch": { "type": "string", "enum": ["B-I", "B-II", "ALL"] },
        "subjectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectShortName": { "type": "string", "maxLength": 40 },
        "subjectName": { "type": "string", "maxLength": 180 },
        "date": { "type": "string", "maxLength": 16, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "period": { "type": "number" },
        "classroom": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "source": { "type": "string", "enum": ["rfid", "manual"] },
        "deviceId": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "facultyId": { "type": "string", "maxLength": 128 },
        "facultyUid": { "type": "string", "maxLength": 128 },
        "facultyEmail": { "type": "string", "maxLength": 200 },
        "facultyName": { "type": "string", "maxLength": 120 },
        "isSubstituted": { "type": "boolean" },
        "substitutionId": { "type": "string", "maxLength": 128 },
        "scanTimestamp": { "type": "string", "format": "date-time" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "correctedBy": { "type": "string", "maxLength": 120 },
        "correctionReason": { "type": "string", "maxLength": 300 },
        "isDemo": { "type": "boolean" }
      },
      "required": ["studentDocId", "studentId", "studentName", "studentEmail", "rollNumber", "classId", "className", "section", "batch", "subjectId", "subjectShortName", "subjectName", "date", "period", "classroom", "status", "source", "scanTimestamp", "recordedAt", "updatedAt"]
    },
    "RfidDevice": {
      "title": "RfidDevice",
      "description": "Registered ESP32 RC522 RFID reader hardware node.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "classroom": { "type": "string", "maxLength": 64 },
        "assignedClassId": { "type": "string", "maxLength": 128 },
        "assignedClassName": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "connectionStatus": { "type": "string", "enum": ["online", "offline", "unconfigured"] },
        "lastSyncAt": { "type": "string", "format": "date-time" },
        "pendingUploads": { "type": "number" },
        "firmwareVersion": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "name", "classroom", "assignedClassId", "assignedClassName", "status", "connectionStatus", "pendingUploads", "createdAt", "updatedAt"]
    },
    "DeviceScanEvent": {
      "title": "DeviceScanEvent",
      "description": "Idempotent ESP32 RFID scan event log including offline-synced and flagged scans.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceId": { "type": "string", "maxLength": 128 },
        "rfidUid": { "type": "string", "maxLength": 64 },
        "classroom": { "type": "string", "maxLength": 64 },
        "scanTimestamp": { "type": "string", "format": "date-time" },
        "date": { "type": "string", "maxLength": 16 },
        "period": { "type": "number" },
        "status": { "type": "string", "enum": ["processed", "flagged_no_timetable", "invalid_card", "duplicate", "offline_synced"] },
        "studentDocId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "rollNumber": { "type": "string", "maxLength": 32 },
        "subjectName": { "type": "string", "maxLength": 180 },
        "message": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "deviceId", "rfidUid", "classroom", "scanTimestamp", "date", "status", "message", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable institutional audit log entry.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "enum": ["student", "faculty", "attendance", "timetable", "substitution", "device", "settings", "auth"] },
        "performedByUid": { "type": "string", "maxLength": 128 },
        "performedByName": { "type": "string", "maxLength": 120 },
        "performedByEmail": { "type": "string", "maxLength": 200 },
        "performedByRole": { "type": "string", "enum": ["admin", "faculty", "student", "system"] },
        "targetType": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetLabel": { "type": "string", "maxLength": 200 },
        "previousValue": { "type": "string", "maxLength": 500 },
        "updatedValue": { "type": "string", "maxLength": 500 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "category", "performedByUid", "performedByName", "performedByEmail", "performedByRole", "targetType", "targetId", "targetLabel", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Academic announcement, notice, or timetable update.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "enum": ["announcement", "academic", "timetable", "college"] },
        "targetRole": { "type": "string", "enum": ["all", "student", "faculty"] },
        "classId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "category", "targetRole", "authorName", "authorUid", "isPinned", "createdAt", "updatedAt"]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Access request submitted by an unregistered Google account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "requestedRole": { "type": "string", "enum": ["student", "faculty"] },
        "rollNumber": { "type": "string", "maxLength": 32 },
        "department": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "ConnectionCheck": {
      "title": "ConnectionCheck",
      "description": "Startup Firestore server connectivity check document.",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin records."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user role bindings and metadata."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PortalSettings" },
      "description": "Configurable institutional branding and portal settings."
    },
    "/departments/{deptId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Academic departments."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/AcademicClass" },
      "description": "Classes, semesters, sections, and batches."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Theory, lab, and activity subjects."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Registered student profiles."
    },
    "/faculty/{facultyId}": {
      "schema": { "$ref": "#/entities/Faculty" },
      "description": "Registered faculty profiles."
    },
    "/timetable/{entryId}": {
      "schema": { "$ref": "#/entities/TimetableEntry" },
      "description": "Weekly master timetable period blocks."
    },
    "/substitutions/{subId}": {
      "schema": { "$ref": "#/entities/Substitution" },
      "description": "Temporary date/period subject & faculty substitutions."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Student attendance records keyed deterministically."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/RfidDevice" },
      "description": "ESP32 RFID reader hardware inventory."
    },
    "/deviceScans/{eventId}": {
      "schema": { "$ref": "#/entities/DeviceScanEvent" },
      "description": "ESP32 RFID scan event queue & offline sync audit."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable institutional activity logs."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Academic notices and portal announcements."
    },
    "/accessRequests/{requestId}": {
      "schema": { "$ref": "#/entities/AccessRequest" },
      "description": "Access requests from unregistered Google accounts."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionCheck" },
      "description": "Startup Firestore server connectivity test path."
    }
  }
}
